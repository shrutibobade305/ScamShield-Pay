# ==========================================
# ScamShield Pay - Environment Configuration
# ==========================================

# Flask Security (Generate a secure key for production)
SECRET_KEY=replace_with_a_secure_random_key_e.g._secrets_token_hex_32
FLASK_DEBUG=False
PORT=5000

# PayPal Sandbox API Credentials
# Obtain your Sandbox Client ID and Client Secret from:
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal API Base URL
# Sandbox: https://api-m.sandbox.paypal.com
# Live / Production: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional URLs
APP_BASE_URL=http://127.0.0.1:5000
PAYPAL_RETURN_URL=http://127.0.0.1:5000/payment/success
PAYPAL_CANCEL_URL=http://127.0.0.1:5000/payment/cancel

